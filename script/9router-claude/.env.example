# Copie para .env e preencha:  cp .env.example .env

# --- 9Router (conversor → upstream) ---------------------------------------
UPSTREAM_BASE_URL=http://127.0.0.1:20338/v1
# OBRIGATÓRIA: chave da API do 9Router (o gateway injeta; clientes nunca veem)
GATEWAY_UPSTREAM_API_KEY=

# --- Modelo padrão quando o cliente não envia "model" ----------------------
# No Claude Code use o mesmo valor em ANTHROPIC_MODEL:
#   export ANTHROPIC_BASE_URL=http://127.0.0.1:11435
#   export ANTHROPIC_MODEL=claude-sonnet-5
DEFAULT_MODEL=claude-sonnet-5

# --- Endereços locais -------------------------------------------------------
GATEWAY_LISTEN_ADDR=127.0.0.1:11435
CONVERTER_URL=http://127.0.0.1:8080

# --- Multi-upstream (opcional) ---------------------------------------------
# UPSTREAMS_CONFIG=upstreams.yaml   # caminho do YAML; sem ele o gateway monta 1 upstream do env
# NINEROUTER_API_KEY_2=            # só se você descomentar o upstream secundário
# OPENAI_API_KEY=                  # só se você descomentar o openai-direct
