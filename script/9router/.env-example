# sbx — 9Router Environment (federal + pool)
#
# São DOIS arquivos de env, um por stack — o pool regrava o seu em todo
# `pool create`/`pool scale`, e não pode apagar as variáveis do federal.
#
#   cp .env-example .env.federal   # só a seção "federal"
#   cp .env-example .env.pool      # só a seção "pool"
# (ou edite cada um mantendo as seções que lhe dizem respeito)

# ---- comum às duas stacks ----
TZ=America/Sao_Paulo
ROUTER_DEBUG=false
JWT_SECRET=token
INITIAL_PASSWORD=123456

# ---- stack federal (docker-compose.federal.yaml) ----
ROUTER_PORT_001=20338
ROUTER_PORT_002=20339

# ---- stack pool (docker-compose.pool.yaml) ----
ROUTER_PORT_MASTER=20228
ROUTER_PORT_SLAVE_000=20129
ROUTER_PORT_SLAVE_001=20130
ROUTER_PORT_SLAVE_002=20131
