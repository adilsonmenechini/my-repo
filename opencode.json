{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "ai-memory": {
        "type": "remote",
        "url": "{file:.env:AI_MEMORY_BASE_URL}",
        "oauth": false,
        "headers": {
